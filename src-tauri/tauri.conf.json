{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZPermissions",
  "version": "0.1.0",
  "identifier": "com.theholyonez.zpermissions",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZPermissions",
        "width": 1280,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TheHolyOneZ",
    "category": "Utility",
    "copyright": "Copyright (C) 2026 TheHolyOneZ",
    "shortDescription": "Cross-platform file permission manager",
    "longDescription": "ZPermissions is a cross-platform desktop application for reading, understanding, and modifying file system permissions across Linux, macOS, and Windows through a unified spatial interface. Supports POSIX chmod, Unix ACLs, and Windows file attributes with a staged-changes workflow.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libappindicator3-1"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null,
      "signingIdentity": null,
      "providerShortName": null
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
